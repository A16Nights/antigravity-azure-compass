{
  "agent-presets": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./hooks/session-start.mjs",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./hooks/pre-invocation.mjs",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "read_file|view_file|Read",
        "type": "command",
        "command": "node ./hooks/pre-tool-use.mjs",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./hooks/stop.mjs",
        "timeout": 25
      }
    ]
  }
}
